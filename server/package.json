{
  "name": "seo-platform-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Express + Prisma + Supabase backend for the SEO dashboard. Supabase-only, no filesystem data source.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke-test.mts",
    "setup:crawler": "cd crawler && npm install"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@supabase/supabase-js": "^2.112.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "mysql2": "^3.23.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "prisma": "6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
