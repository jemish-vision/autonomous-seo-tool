// =============================================================================
// Combined SEO Crawler Platform — data model
// Postgres 16 (Supabase) · Prisma 6.x  (see PLAN-02 §0.2 — 7.x moves the URLs out of here)
// Extracted verbatim from D:\projects\seo-team-audit\PLAN-02-Data-Model.md §3
// Validated there: prisma@6.19.3 validate + migrate diff --from-empty
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  // Generated into packages/db/generated/client so callers outside this package (the crawler's
  // dynamic-import adapter) resolve @prisma/client's runtime via THIS package's node_modules,
  // without needing an npm dependency or workspace link of their own.
  output          = "../src/db/generated/client"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pg_trgm(schema: "extensions"), pgcrypto(schema: "extensions")]
}

